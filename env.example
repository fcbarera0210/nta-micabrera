# Auth.js v5 (https://authjs.dev)
# Genera el secreto con: openssl rand -hex 32
# O en Windows PowerShell: -join ((1..32) | ForEach-Object { '{0:X2}' -f (Get-Random -Max 256) })
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Neon (PostgreSQL) — copia la "pooled connection string" desde el dashboard de Neon
DATABASE_URL=

# Opcional: Blob (Vercel) para imágenes más adelante
# BLOB_READ_WRITE_TOKEN=
